# 引擎本地配置模板。复制为 engine/.env 后填写（engine/.env 已被 .gitignore 忽略，绝不要提交）。
#   cp engine/.env.example engine/.env
#
# 只在开发模式（pnpm dev / pnpm dev:engine / 命令行 run.ts）下读取。
# 打包后的桌面 App 不读这个文件：模型服务在界面设置里配置，Key 按地址经系统钥匙串加密保存，见 electron/src/main/aiKeys.ts。
# 已存在的同名环境变量优先于本文件；界面里保存的设置优先于环境变量。

# ---------- 模型服务（OpenAI 兼容接口）----------
# 接口地址。须为 https；回环地址（localhost / 127.0.0.1 / [::1]）可用 http。省略则用默认的 Google Gemini 兼容地址。
# STILLSCRIBE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# API Key，属于上面的接口地址（未设接口地址时属于默认地址）。本机模型可留空。
# 留空且没有在界面里保存 Key，则自动生成无法进行：任务转入人工校对，并在校对页显示原因。
STILLSCRIBE_AI_API_KEY=

# 模型名（必须能看图）。省略用代码默认值（shared/types.ts 的 AI_DEFAULTS.model）。
# STILLSCRIBE_AI_MODEL=gemini-2.5-flash

# 旧变量名，已弃用，仍可用：STILLSCRIBE_GEMINI_API_KEY（属于默认地址）、STILLSCRIBE_GEMINI_MODEL（作模型兜底）。
# 新旧同时设置时以 STILLSCRIBE_AI_* 为准。

# 喂图方式：grids = 宫格图（默认，省 token）；frames = 去重后的代表单帧（更清楚，成本高得多）。
# STILLSCRIBE_AI_IMAGE_SOURCE=grids

# ---------- 引擎服务（一般不用改）----------
# 工作根目录，任务产物与数据库都在其下。相对路径按 engine/ 目录解析。
# STILLSCRIBE_WORK_ROOT=./work

# 监听地址与端口。引擎只应监听本机回环地址。
# STILLSCRIBE_HOST=127.0.0.1
# STILLSCRIBE_PORT=8787

# 接口令牌。省略则每次启动自动生成，并写入 <工作根>/engine-token 供开发代理读取。
# STILLSCRIBE_TOKEN=

# 允许跨源访问引擎的页面来源，逗号分隔。默认为空；经 Vite 开发代理访问时不需要配置。
# STILLSCRIBE_ALLOWED_ORIGINS=

# ---------- YouTube 下载 ----------
# 没有可用的 cookies.txt 时，从哪个浏览器读取登录态（yt-dlp --cookies-from-browser）。
# 可选：safari / chrome / edge / firefox / opera
# STILLSCRIBE_BROWSER=chrome

# 显式指定 Netscape 格式的 cookies.txt。默认使用 <工作根>/cookies.txt（由 pnpm refresh-cookies 生成）。
# STILLSCRIBE_COOKIES_FILE=

# ---------- 外部命令行工具（一般不用改）----------
# 默认使用 pnpm setup-tools 下载到仓库 bin/ 下的版本。要换成自己的构建时，填绝对路径。
# STILLSCRIBE_FFMPEG=
# STILLSCRIBE_FFPROBE=
# STILLSCRIBE_YT_DLP=
# STILLSCRIBE_DENO=
